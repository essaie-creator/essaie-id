# GEMINI_API_KEY: Optional - Only needed if NOT using OAuth Sign in with Google.
# If you want to use OAuth, leave this empty and configure GOOGLE_CLIENT_ID/SECRET instead.
GEMINI_API_KEY=""

# OAuth 2.0 Configuration (for "Sign in with Google" feature)
# Create these in Google Cloud Console > APIs & Services > Credentials
# GOOGLE_CLIENT_ID: Your OAuth 2.0 Client ID
# GOOGLE_CLIENT_SECRET: Your OAuth 2.0 Client Secret  
# OAUTH_REDIRECT_URI: Must match the redirect URI in Google Cloud Console (default: http://localhost:3000/auth/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_REDIRECT_URI="http://localhost:3000/auth/callback"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
